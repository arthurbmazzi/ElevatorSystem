{
  "Urls": "http://localhost:5080",
  "FileLog": {
    "Directory": "logs",
    "MaxFileBytes": 10485760,
    "RetainedFiles": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Elevators": {
    "StepIntervalMilliseconds": 500,
    "StuckTimeoutSeconds": 30
  }
}
